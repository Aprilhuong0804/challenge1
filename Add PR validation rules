.github/workflows/pr-check.yml
name: Validate Pull Request Rules

on:
  pull_request:
    types: [opened, edited, synchronize, reopened]

jobs:
  validate-pr:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout code
        uses: actions/checkout@v3

      - name: Validate PR rules
        uses: actions/github-script@v7
        with:
          script: |
            const pr = context.payload.pull_request;

            // Rule 1: Description at least 20 characters
            if (!pr.body || pr.body.length < 20) {
              core.setFailed("❌ Pull request description must be at least 20 characters.");
            }

            // Rule 2: No changes to package-lock.json
            const changedFiles = await github.rest.pulls.listFiles({
              owner: context.repo.owner,
              repo: context.repo.repo,
              pull_number: pr.number,
            });

            const files = changedFiles.data.map(f => f.filename);
            if (files.includes('package-lock.json')) {
              core.setFailed("❌ Pull request must not include changes to `package-lock.json`.");
            }

            // Rule 3: Fewer than 5 files
            if (files.length >= 5) {
              core.setFailed("❌ Pull request must contain fewer than 5 files.");
            }

            // Rule 4: Title must start with ticket number (e.g. PROJ-123)
            const titlePattern = /^[A-Z]+-\d+\s.+/;
            if (!titlePattern.test(pr.title)) {
              core.setFailed("❌ Pull request title must start with a ticket number (e.g. PROJ-123).");
            }
